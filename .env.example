NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase production foundation
# Use the Project URL and an active publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# BILOO public application configuration
NEXT_PUBLIC_BILOO_API_URL=
NEXT_PUBLIC_BILOO_MAP_PROVIDER=google
# Browser-restricted Google Maps Platform key.
# Enable Maps JavaScript API, Places API (New), and Routes API.
NEXT_PUBLIC_BILOO_MAPS_KEY=

# Server-only configuration. Never expose these with NEXT_PUBLIC_ prefixes.
DATABASE_URL=
AUTH_SECRET=
BILOO_PAYMENT_PROVIDER=
BILOO_PAYMENT_SECRET_KEY=
BILOO_PAYMENT_WEBHOOK_SECRET=
BILOO_PUSH_PROVIDER=
BILOO_PUSH_SERVER_KEY=
